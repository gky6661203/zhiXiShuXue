# 复制本文件为 backend/.env 后填入真实值。
# backend/.env 已在 .gitignore 中忽略，切勿提交到仓库。

# 后端端口
API_PORT=5001

# 通用大模型（批改等功能使用）
LLM_API_ENDPOINT=
LLM_MODEL=
LLM_API_KEY=

# OCR 识别
OCR_API_KEY=
OCR_API_SECRET=

# 正式部署使用 production、HTTPS，并设置独立数据目录与随机密钥
NODE_ENV=development
WEB_ORIGIN=http://localhost:5000
# DATA_DIR=绝对路径
JWT_SECRET=
# 初次初始化生产数据库时必填，至少 12 位
ADMIN_PASSWORD=

# 默认只监听本机；正式部署通过 HTTPS 反向代理访问
API_HOST=127.0.0.1
# UPLOAD_DIR=绝对路径（默认 backend/uploads）
